{
  "expo": {
    "name": "Lucid",
    "slug": "lucid-dream-journal",
    "scheme": "lucid",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lucid to record your dream so it can turn your voice into a private journal page."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucid.dreamjournal"
    },
    "android": {
      "package": "com.lucid.dreamjournal"
    }
  }
}
