# Neon Postgres
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"

# Voice transcription + richer surface entity extraction.
# Audio is sent for transcription and is not persisted by Tardemah.
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="gpt-transcribe"
OPENAI_ANALYSIS_MODEL="gpt-6-luna"

# Public URL used for metadata (Open Graph links).
NEXT_PUBLIC_SITE_URL="https://your-tardemah-domain.example"
