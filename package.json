{
  "name": "tardemah",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev:web": "pnpm --filter @tardemah/web dev",
    "dev:mobile": "pnpm --filter @tardemah/mobile start",
    "build:web": "pnpm --filter @tardemah/web build",
    "db:generate": "pnpm --filter @tardemah/database prisma generate",
    "db:validate": "pnpm --filter @tardemah/database prisma validate",
    "db:push": "pnpm --filter @tardemah/database prisma db push",
    "db:migrate": "pnpm --filter @tardemah/database prisma migrate deploy",
    "db:studio": "pnpm --filter @tardemah/database prisma studio"
  }
}
